{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zedflow.dev/tui-parity/fixture-v2.json",
  "title": "Zedflow TUI parity semantic fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dimensions", "capabilities", "events"],
  "properties": {
    "version": { "const": 2 },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "dimensions": {
      "type": "object", "additionalProperties": false, "required": ["columns", "rows"],
      "properties": { "columns": { "type": "integer", "minimum": 1, "maximum": 1000 }, "rows": { "type": "integer", "minimum": 1, "maximum": 1000 } }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["colors", "unicode", "kittyKeyboard"],
      "properties": { "colors": { "enum": [0, 16, 256, 16777216] }, "unicode": { "type": "boolean" }, "kittyKeyboard": { "type": "boolean" } }
    },
    "event": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "data"], "properties": { "type": { "const": "input" }, "data": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "columns", "rows"], "properties": { "type": { "const": "resize" }, "columns": { "type": "integer", "minimum": 1, "maximum": 1000 }, "rows": { "type": "integer", "minimum": 1, "maximum": 1000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": {
          "type": { "const": "lifecycle" },
          "name": { "enum": ["message_start", "message_update", "message_end", "tool_start", "tool_update", "tool_end", "abort", "error", "queue", "compaction_start", "compaction_end", "session"] },
          "data": { "type": ["object", "array", "string", "number", "boolean", "null"] }
        } }
      ]
    }
  }
}

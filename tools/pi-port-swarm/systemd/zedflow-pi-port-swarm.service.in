[Unit]
Description=Zedflow Pi port swarm coordinator

[Service]
Type=oneshot
WorkingDirectory=@SOURCE@
Environment=PATH=@PATH@
Environment=PI_SKIP_VERSION_CHECK=1
Environment=PI_TELEMETRY=0
Environment=PI_SUBAGENT_MAX_SPAWNS_PER_SESSION=18
Environment=PI_SUBAGENT_WAIT_TOOL_ENABLED=true
Environment=CARGO_TARGET_DIR=/tmp/zedflow-pi-port-swarm-target
Environment=TMPDIR=/tmp/zedflow-pi-port-swarm-tmp
ExecStart=@PYTHON@ @SWARM@ --source @SOURCE@ tick
StandardInput=null
Restart=no
KillMode=control-group
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true

